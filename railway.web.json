{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm railway:web:build",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/.env.example",
      "/railway.web.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm railway:migrate",
    "startCommand": "pnpm railway:migrate && pnpm railway:web:start",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
