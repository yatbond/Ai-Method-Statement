{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm railway:worker:build",
    "watchPatterns": [
      "/services/worker/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/.env.example",
      "/railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm railway:worker:start",
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
