# =============================================================================
# AI Method Statement Studio — Environment Variables
# Copy to .env and fill in values before running locally
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_method_statement"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_method_statement"

# ── Authentication (NextAuth.js / SSO) ────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Azure AD SSO (production)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ── AI Providers ──────────────────────────────────────────────────────────────
# Google Gemini Embedding 2 (required — REQ-RAG-002)
GOOGLE_AI_API_KEY=""
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# LLM provider (choose one)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Document AI provider
DOCUMENT_AI_PROVIDER="google"  # google | azure | aws
GOOGLE_DOCUMENT_AI_PROJECT_ID=""
GOOGLE_DOCUMENT_AI_LOCATION=""
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=""

# Image generation provider (v1.2 — off by default)
IMAGE_GEN_PROVIDER=""
IMAGE_GEN_API_KEY=""
IMAGE_GEN_ENABLED="false"

# ── Object Storage ────────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"  # local | s3
LOCAL_STORAGE_PATH="./.storage"  # used when STORAGE_PROVIDER=local (dev)

# S3 / MinIO (set STORAGE_PROVIDER=s3 for production)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-2"
AWS_S3_BUCKET="ai-method-statement-documents"
# S3_ENDPOINT="http://localhost:9000"  # uncomment to use local MinIO

# ── Background Workers (BullMQ / Redis) ───────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Application ───────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"

# Monthly AI cost ceiling (GBP) — triggers admin alert when 80% reached
MONTHLY_COST_CEILING_GBP="5000"

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="ai-method-statement-studio"
