# =============================================================================
# AI Method Statement Studio — Environment Variables
# Copy to .env and fill in values before running locally
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_method_statement"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_method_statement"

# ── Authentication (Clerk) ────────────────────────────────────────────────────
# Get these from https://clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Get from Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=""

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/projects

# Default org for newly created users (must match a seeded Organisation.id)
DEFAULT_ORGANISATION_ID="default"

# ── AI Providers ──────────────────────────────────────────────────────────────
# Google Gemini Embedding 2 (required — REQ-RAG-002)
GOOGLE_AI_API_KEY=""
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# LLM provider (choose one: anthropic, openai, ollama)
LLM_PROVIDER="ollama"  # anthropic | openai | ollama
LLM_MODEL=""           # optional override for anthropic/openai default model

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Ollama Cloud (set LLM_PROVIDER="ollama")
OLLAMA_API_KEY=""
OLLAMA_MODEL=""                                # required — e.g. gemini-3-flash-preview
OLLAMA_BASE_URL="https://ollama.com/v1"       # or your own Ollama server

# Document AI provider (native | gemini | ollama | openrouter)
DOCUMENT_AI_PROVIDER="native"
DOCUMENT_AI_API_KEY=""         # API key for your chosen provider
DOCUMENT_AI_MODEL=""           # model name (e.g. gemini-2.5-flash, kimi-k2.6:cloud, google/gemini-2.5-flash)
DOCUMENT_AI_BASE_URL=""        # only needed for ollama/openrouter (defaults: https://ollama.com/v1 or https://openrouter.ai/api/v1)

# Image generation provider (openai | gemini | ollama | openrouter)
IMAGE_GEN_ENABLED="false"
IMAGE_GEN_PROVIDER="openai"
IMAGE_GEN_API_KEY=""           # API key for your chosen provider
IMAGE_GEN_MODEL=""             # model name (e.g. gpt-image-1, imagen-3.0-generate-002, flux)
IMAGE_GEN_BASE_URL=""          # only needed for ollama/openrouter

# ── Object Storage ────────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"  # local | s3
LOCAL_STORAGE_PATH="./.storage"  # used when STORAGE_PROVIDER=local (dev)

# S3 / MinIO / Cloudflare R2 (set STORAGE_PROVIDER=s3 for production)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-2"
AWS_S3_BUCKET="ai-method-statement-documents"
# S3_ENDPOINT="http://localhost:9000"  # uncomment to use local MinIO

# Cloudflare R2 example:
# STORAGE_PROVIDER="s3"
# AWS_REGION="auto"
# AWS_S3_BUCKET="ai-method-statement-documents"
# CLOUDFLARE_R2_ACCOUNT_ID=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="false"

# ── Background Workers (BullMQ / Redis) ───────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Application ───────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"

# Monthly AI cost ceiling (GBP) — triggers admin alert when 80% reached
MONTHLY_COST_CEILING_GBP="5000"

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="ai-method-statement-studio"
